# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp (meta | twilio) ─────────────────
WHATSAPP_PROVIDER=twilio

# Twilio (si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Validación de firma del webhook (déjalo en true en producción)
VALIDAR_FIRMA_TWILIO=true

# Meta Cloud API (si WHATSAPP_PROVIDER=meta)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (Supabase / PostgreSQL — usa el "Session pooler"):
DATABASE_URL=

# ── Panel y seguridad ─────────────────────────────────────
# Clave para firmar las sesiones del panel (cadena larga y aleatoria)
SECRET_KEY=
# Usuario admin por defecto del PANEL_USER (opcional; el login real usa la tabla usuarios)
PANEL_USER=admin
PANEL_PASSWORD=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development  # development | production
